{
	admin off
	persist_config off
	skip_install_trust
	auto_https disable_redirects
	default_bind {$APP_HTTPS_IDE_LAN_HOST}
	default_sni {$APP_HTTPS_IDE_LAN_HOST}
	storage file_system "{$APP_HTTPS_CA_DIR}"
	servers {
		protocols h1 h2
	}
}

https://{$APP_HTTPS_IDE_LAN_HOST}:8443 {
	tls internal
	@wrongHost expression `{http.request.hostport} != "{$APP_HTTPS_IDE_LAN_HOST}:8443"`
	respond @wrongHost 421
	header -Strict-Transport-Security
	reverse_proxy 127.0.0.1:8080 {
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {$APP_HTTPS_IDE_LAN_HOST}
		header_up X-Forwarded-Port 8443
		header_up Host {$APP_HTTPS_IDE_LAN_HOST}:8443
	}
}

https://:8443 {
	respond 421
}
