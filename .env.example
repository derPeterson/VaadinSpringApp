# Diese Datei nach .env kopieren und eigene Werte eintragen.

# --- Lokale Entwicklung ---
APP_SECURITY_EXPOSE_H2_CONSOLE=true

# --- Zwei-Faktor-Authentifizierung ---
# Authenticator-Schlüssel: 32 zufällige Bytes, Base64-kodiert. Getrennt von der DB sichern.
# Einmalig in PowerShell 7 erzeugen: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Nicht ins Repository übernehmen. Ohne Schlüssel bleibt die Einrichtung gesperrt.
APP_SECURITY_TOTP_ENCRYPTION_KEY=

# Nur in eigener Entwicklung aktivieren. Schaltet lediglich die zusätzlichen Warn-/Testoptionen frei.
# Die einzelnen Ausnahmen bleiben aus, bis ein Superadmin sie bewusst einschaltet.
APP_SECURITY_DEVELOPMENT_OPTIONS_ENABLED=false

# --- Anmeldeanbieter: Google und Microsoft ---
# Eigener, dauerhafter Schlüssel für verschlüsselte Client-Secrets in der Datenbank.
# 32 zufällige Bytes als Base64 erzeugen, wie oben beim Authenticator-Schlüssel.
# Einen anderen Wert als für TOTP verwenden. Getrennt von der Datenbank sichern.
# Ohne Schlüssel können keine Client-Secrets gespeichert oder entschlüsselt werden.
APP_SECURITY_PROVIDER_SECRETS_ENCRYPTION_KEY=
# Optionale Startvorgaben (Einrichtung: docs/externe-anmeldung.md).
# Bevorzugt im Adminbereich unter Konfiguration / Anmeldeanbieter einrichten und aktivieren.
# Fehlende Anbieter werden beim Start mit diesen Werten in external_providers angelegt.
# Gespeicherte Anbieter-Einstellungen haben Vorrang, auch eine gespeicherte Deaktivierung.
# Aktivierung benötigt ENABLED=true sowie Client-ID UND Client-Secret.
# Nur Änderungen dieser Startvorgaben erfordern einen Neustart. Adminänderungen gelten sofort.
# Google: OAuth-Client vom Typ Webanwendung in der Google Cloud Console anlegen.
# Autorisierte Redirect-URI: https://localhost:8443/login/oauth2/code/google
APP_EXTERNAL_LOGIN_GOOGLE_CLIENT_ID=
APP_EXTERNAL_LOGIN_GOOGLE_CLIENT_SECRET=
APP_EXTERNAL_LOGIN_GOOGLE_ENABLED=false
# Microsoft: Web-App in Microsoft Entra registrieren, für Organisationsverzeichnisse UND persönliche Konten.
# Client-ID: Anwendungs-ID (Client). Client-Secret: den geheimen WERT verwenden, nicht die Secret-ID.
# Web-Redirect-URI: https://localhost:8443/login/oauth2/code/microsoft
# Ablaufdatum des Secrets beachten. Eine eigene Tenant-ID ist für den gemeinsamen Einstieg nicht nötig.
APP_EXTERNAL_LOGIN_MICROSOFT_CLIENT_ID=
APP_EXTERNAL_LOGIN_MICROSOFT_CLIENT_SECRET=
APP_EXTERNAL_LOGIN_MICROSOFT_ENABLED=false

# --- Optionale initiale Benutzer nach Rolle ---
APP_BOOTSTRAP_ENABLED=false
# Listen werden als Spring-Properties aus dieser Datei importiert. Indizes je Liste ab 0.
# app.bootstrap.superadmins[0].email=superadmin@example.test
# app.bootstrap.superadmins[0].password=NurFuerTests1!
# app.bootstrap.superadmins[1].email=second-superadmin@example.test
# app.bootstrap.superadmins[1].password=NurFuerTests2!
# app.bootstrap.admins[0].email=admin@example.test
# app.bootstrap.admins[0].password=NurFuerTests3!
# Vollständiger Beispielbenutzer; zum Verwenden Zeilen aktivieren und eigene Werte setzen.
# Standardwerte für nicht angegebene Profilfelder: BootstrapAccountsProperties.java, innere Klasse Account.
# app.bootstrap.users[0].email=user@example.test
# app.bootstrap.users[0].password=NurFuerTests4!
# app.bootstrap.users[0].first-name=Jane
# app.bootstrap.users[0].last-name=Doe
# app.bootstrap.users[0].birth-date=1992-05-04
# app.bootstrap.users[0].gender=OTHER
# app.bootstrap.users[0].preferred-locale=de
# E-Mail-Nachweis pro Startkonto, auch bei superadmins/admins/guests verwendbar.
# false (Standard, auch ohne Angabe): direkt nutzbar, "Nicht geprüft", keine Bestätigungsmail.
# true: Bestätigungsmail bei der ersten Anlage; Portalzugang erst nach Bestätigung.
# app.bootstrap.users[0].email-verification-required=false
# Wirkt nur bei neuen Konten beim Start. Bestehende Konten bleiben unverändert.
# Anleitung: docs/entwicklung.md, Abschnitt "E-Mail-Bestätigung für Startkonten".
# Geburtsdatum: JJJJ-MM-TT; Geschlecht: MALE/FEMALE/OTHER; Sprache: de/en.
# app.bootstrap.guests[0].email=guest@example.test
# app.bootstrap.guests[0].password=NurFuerTests5!

# --- Admin-Konfiguration: Startvorgaben ---
# Gelten nur für fehlende Datenbankeinträge. Gespeicherte Adminwerte haben Vorrang.
# Änderungen an diesen Startvorgaben benötigen einen Neustart.

# Allgemein
APP_CFG_SERVICE_NAME=derPeter
# Platzhalter: {year} und {serviceName}. \u00A9 steht für das Copyright-Zeichen.
APP_CFG_COPYRIGHT_TEXT=\u00A9 {year} {serviceName}
APP_CFG_BASE_URL=http://localhost:8080/

# Sicherheit und Sitzungen
# Login speichern: Dauer in Sekunden (1209600 = 14 Tage).
APP_CFG_REMEMBER_ME_DURATION=1209600
APP_CFG_REMEMBER_ME_SECRET_KEY=change-me-remember-me-secret
APP_CFG_LOGIN_ATTEMPTS_LIMIT=10
APP_CFG_LOGIN_ATTEMPT_WINDOW_SECONDS=900
APP_CFG_MAX_SESSIONS_PER_USER=3
# Inaktivitätsfrist aktiver Sitzungen in Sekunden (1800 = 30 Minuten).
APP_CFG_SESSION_TIMEOUT_SECONDS=1800
APP_CFG_MAINTENANCE_MODE=false

# Token-Laufzeiten: ISO 8601, z. B. PT3H = 3 Stunden, P7D = 7 Tage.
# LIVE_DURATION bezeichnet die Aufbewahrung nach Ablauf der Gültigkeit.
APP_CFG_VERIFICATION_TOKEN_VALID_DURATION=PT24H
APP_CFG_VERIFICATION_TOKEN_LIVE_DURATION=P7D
APP_CFG_PASSWORD_RESET_TOKEN_VALID_DURATION=PT3H
APP_CFG_PASSWORD_RESET_TOKEN_LIVE_DURATION=P3D

# Benutzerstatus: Inaktivität bis Abwesend, ISO 8601 (PT10M = 10 Minuten).
APP_CFG_USER_AUTO_ABSENT_TIMEOUT=PT10M

# Benachrichtigungen: Aufbewahrung in Tagen, leer = unbegrenzt, 0 ist ungültig.
APP_CFG_USER_NOTIFICATIONS_INBOX_RETENTION_DAYS=180
APP_CFG_USER_NOTIFICATIONS_HISTORY_RETENTION_DAYS=365

# E-Mail-Absender und administrative Kontaktadresse
APP_CFG_EMAIL_FROM=no-reply@example.com
APP_CFG_EMAIL_ADMIN=admin@example.com

# SMTP-Verbindung
APP_CFG_MAIL_HOST=localhost
APP_CFG_MAIL_PORT=1025
APP_CFG_MAIL_USERNAME=
APP_CFG_MAIL_PASSWORD=
APP_CFG_MAIL_SMTP_AUTH=true
APP_CFG_MAIL_SMTP_STARTTLS_ENABLE=false
APP_CFG_MAIL_SMTP_SSL_ENABLE=false
APP_CFG_MAIL_SMTP_SSL_TRUST=*
APP_CFG_MAIL_DEBUG=false

# E-Mail-Queue: Workerzahl, Kapazität und maximale Wiederholungen.
APP_CFG_EMAIL_QUEUE_POOL_SIZE=5
APP_CFG_EMAIL_QUEUE_CAPACITY=50
APP_CFG_EMAIL_QUEUE_MAX_RETRY=3
APP_CFG_EMAIL_QUEUE_RETRY_DELAY_SECONDS=60
# Aufbewahrung versendeter Einträge, ISO 8601 (P7D = 7 Tage).
APP_CFG_EMAIL_QUEUE_SENT_LIVE_DURATION=P7D
