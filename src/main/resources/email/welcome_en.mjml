<mjml>
  <mj-head>
    <mj-preview>Willkommen! Bitte verifiziere deine E-Mail</mj-preview>
    <mj-style inline="inline">
      .button {
        background-color: #0b66dd;
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#233348">
    <mj-section>
      <mj-column>
        <mj-image width="128px" src="data:image/png;base64,{{SERVICE_LOGO}}" alt="Logo" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#2c3d52" border-radius="10px" padding="20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#ffffff" align="center">Welcome {{FIRST_NAME}} {{LAST_NAME}} to {{SERVICE_NAME}}!</mj-text>
        <mj-text font-size="16px" color="#ffffff" align="center">Thank you for registering with our service.</mj-text>
        <mj-text font-size="16px" color="#ffffff" align="center">Please confirm your email address to activate your account.</mj-text>
        <mj-button href="{{VERIFICACTION_LINK}}" background-color="#007bff" color="#ffffff" font-size="16px" padding="12px 24px" border-radius="5px" align="center">
          <b>VERIFY EMAIL</b>
        </mj-button>
        <mj-text font-size="14px" color="#bbbbbb" align="center">
          If you have not registered, ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#aaaaaa" align="center">
          © 2025 {{SERVICES_NAME}}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
