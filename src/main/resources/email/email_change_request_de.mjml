<mjml lang="de">
  <mj-head>
    <mj-title>E-Mail-Adresse bestätigen</mj-title>
    <mj-preview>E-Mail-Adresse bestätigen</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, Roboto, Arial, sans-serif" />
      <mj-text color="#a7b7d2" font-size="14px" line-height="24px" align="center" padding="0 12px 12px" />
      <mj-button color="#f3f6ff" background-color="#526ebc" font-size="14px" font-weight="600"
                 border="1px solid #637fc4" border-radius="9px" inner-padding="14px 26px" padding="16px 12px 24px" />
    </mj-attributes>
    <!-- Statischer Cosmos-Hintergrund. Die festen Grundfarben bleiben ohne CSS-Verläufe erhalten.
         !important verhindert, dass MJMLs Inline-background die Hintergrundbilder zurücksetzt. -->
    <mj-style inline="inline">
      .cosmos-email-sky {
        background-color: #040710;
        background-image: radial-gradient(ellipse at 15% 12%, rgba(58, 83, 141, 0.45), transparent 55%),
                          radial-gradient(ellipse at 90% 85%, rgba(82, 110, 188, 0.32), transparent 55%),
                          radial-gradient(circle at 1px 1px, rgba(169, 192, 251, 0.18) 1px, transparent 1.5px) !important;
        background-size: auto, auto, 34px 34px;
        background-repeat: no-repeat, no-repeat, repeat;
      }
      .cosmos-email-card, .cosmos-email-card > table {
        background-color: #101726;
        background-image: linear-gradient(142deg, #101726, #090e19) !important;
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
      }
      .cosmos-email-button td, .cosmos-email-button a {
        background-color: #526ebc;
        background-image: linear-gradient(115deg, #3a538d, #526ebc) !important;
      }
    </mj-style>
  </mj-head>
  <mj-body width="520px" background-color="#040710">
    <mj-wrapper full-width="full-width" background-color="#040710" css-class="cosmos-email-sky" padding="36px 16px">
      <mj-section padding="0 0 28px">
        <mj-column>
          <mj-image width="96px" height="96px" src="cid:{{SERVICE_LOGO}}" alt="{{SERVICE_NAME}}" padding="0 0 14px" />
          <mj-text color="#edf2ff" font-size="17px" font-weight="600" padding="0">{{SERVICE_NAME}}</mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-color="#101726" border="1px solid #2c3751" border-radius="18px"
                  css-class="cosmos-email-card" padding="30px 18px 18px">
        <mj-column>
          <mj-text color="#edf2ff" font-size="26px" font-weight="600" line-height="34px" padding="0 12px 16px">Neue E-Mail-Adresse bestätigen</mj-text>
          <mj-text>Bitte bestätigen Sie {{NEW_EMAIL}} als neue E-Mail-Adresse Ihres Kontos. Bis zur Bestätigung bleibt Ihre bisherige Adresse gültig.</mj-text>
          <mj-button href="{{CONFIRM_EMAIL_LINK}}" css-class="cosmos-email-button">E-MAIL-ADRESSE BESTÄTIGEN</mj-button>
          <mj-text color="#899ab8" font-size="12px" line-height="20px" padding="0 12px 8px">Der Link ist zeitlich begrenzt und kann einmal verwendet werden. Nach der Bestätigung werden alle Sitzungen und gespeicherten Anmeldungen beendet. Melden Sie sich dann mit der neuen Adresse an. Falls Sie diese Änderung nicht angefordert haben, ignorieren Sie diese E-Mail.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="20px 0 0">
        <mj-column>
          <mj-text color="#899ab8" font-size="11px" line-height="18px" padding="0 12px">{{COPYRIGHT_TEXT}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
