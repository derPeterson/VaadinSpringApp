<mjml>
  <mj-head>
    <mj-preview>Forgot your password?</mj-preview>
    <mj-style inline="inline">
      .button {
        background-color: #0b66dd;
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#233348">
    <mj-section>
      <mj-column>
        <mj-image width="128px" src="data:image/png;base64,{{SERVICE_LOGO}}" alt="Logo" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#2c3d52" border-radius="10px" padding="20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#ffffff" align="center">Forgot your password?</mj-text>
        <mj-text font-size="16px" color="#ffffff" align="center">We received a request to reset your password.</mj-text>
        <mj-button href="{{RESET_PASSWORD_LINK}}" background-color="#007bff" color="#ffffff" font-size="16px" padding="12px 24px" border-radius="5px" align="center">
          <b>RESET PASSWORD</b>
        </mj-button>
        <mj-text font-size="14px" color="#bbbbbb" align="center">
          If you didn't make this request, simply ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#aaaaaa" align="center">
          © 2025 {{SERVICES_NAME}}. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
