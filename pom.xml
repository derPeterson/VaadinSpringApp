<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>de.derpeterson</groupId>
    <artifactId>vaadin-spring-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>VaadinSpringApp Reactor</name>

    <!-- app behält den Boot-Parent; Aggregation erfordert keine gemeinsame Vererbung. -->
    <modules>
        <module>shared</module>
        <module>app</module>
        <module>browser-tests</module>
    </modules>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sonar.projectKey>vaadin-spring-app</sonar.projectKey>
    </properties>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <!-- Die Stilprüfung umfasst alle Module genau einmal: Wrapper mit -N aufrufen. -->
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.4</version>
                <inherited>false</inherited>
                <configuration>
                    <!-- Nur seit dem letzten Commit geänderte/neue Dateien bearbeiten. -->
                    <ratchetFrom>HEAD</ratchetFrom>
                    <java>
                        <includes>
                            <include>app/src/main/java/**/*.java</include>
                            <include>app/src/test/java/**/*.java</include>
                            <include>shared/src/main/java/**/*.java</include>
                            <include>shared/src/test/java/**/*.java</include>
                            <include>browser-tests/src/main/java/**/*.java</include>
                            <include>browser-tests/src/test/java/**/*.java</include>
                        </includes>
                        <importOrder>
                            <order>\#,</order>
                        </importOrder>
                        <removeUnusedImports/>
                        <googleJavaFormat>
                            <version>1.36.1</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <inherited>false</inherited>
                <configuration>
                    <configLocation>${project.basedir}/config/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/app/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/app/src/test/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/shared/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/shared/src/test/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/browser-tests/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/browser-tests/src/test/java</sourceDirectory>
                    </sourceDirectories>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.3.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>coverage</id>
            <modules>
                <module>coverage-report</module>
            </modules>
            <properties>
                <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/coverage-report/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.15</version>
                        <configuration>
                            <!-- Nachweis, dass die Messdaten jedes Testmoduls aggregiert wurden. -->
                            <sessionId>${project.artifactId}</sessionId>
                        </configuration>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
