# Lokale Handpruefung; nach data/manual-tests/__LAUF__/ kopieren.
# __LAUF__ durch einen eigenen neuen Laufnamen ersetzen (siehe anwendung.md).
# Werte ohne Anfuehrungszeichen; Windows-Pfade mit / schreiben.
spring.datasource.url=jdbc:h2:file:./data/manual-tests/__LAUF__/appdb;AUTO_SERVER=TRUE;MODE=MySQL;DB_CLOSE_DELAY=-1;SCHEMA=PUBLIC
server.port=18090
server.address=127.0.0.1
app.security.expose-h2-console=false
spring.h2.console.enabled=false

# Nur fuer die erste Adminanlage aktivieren; beide leeren Werte lokal ausfuellen.
app.bootstrap.default-admin.enabled=true
app.bootstrap.default-admin.email=manual-admin@example.test
app.bootstrap.default-admin.password=
app.config.defaults.rememberMe.secret.key=

# Erstbefuellung: vorhandene DB-Werte gehen diesen Vorgaben vor.
app.config.defaults.service.name=Vaadin Handpruefung
app.config.defaults.base.url=http://127.0.0.1:18090/
app.config.defaults.email.from=no-reply@example.test
app.config.defaults.email.admin=manual-admin@example.test
app.config.defaults.mail.host=127.0.0.1
app.config.defaults.mail.port=18125
app.config.defaults.mail.smtp.auth=false
app.config.defaults.mail.smtp.starttls.enable=false
app.config.defaults.mail.smtp.ssl.enable=false
